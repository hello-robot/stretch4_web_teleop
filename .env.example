# Copy this file to .env and fill it in. .env is gitignored and must never be
# committed: it holds this robot's credentials.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Robot identity
# ---------------------------------------------------------------------------
# HELLO_FLEET_ID is this robot's serial. Read it with:
#   cat /etc/hello-robot/hello-robot.conf | grep HELLO_FLEET_ID
HELLO_FLEET_ID=

# ---------------------------------------------------------------------------
# SSL certificates
# ---------------------------------------------------------------------------
# File names only, not paths; they must live in certificates/ and are expected
# to be named after HELLO_FLEET_ID. For HELLO_FLEET_ID=stretch-se4-4001:
#   certfile=stretch-se4-4001+6.pem
#   keyfile=stretch-se4-4001+6-key.pem
certfile=
keyfile=

# ---------------------------------------------------------------------------
# Web teleop hosting
# ---------------------------------------------------------------------------
# local (default) hosts the web teleop interface locally on the robot.
# firebase (optional) will use the cloud launch path
WEB_TELEOP_HOSTING=local

# ---------------------------------------------------------------------------
# Firebase (optional)
# ---------------------------------------------------------------------------
# Leave this whole block empty to run the interface purely on the local
# network. Filling it in puts the robot on your Firebase dashboard; see
# src/pages/operator/tsx/storage_handler/README.md for the full setup.
#
# All eight values are required together. Seven come from the Firebase console
# under Project settings > General > Your apps. databaseURL is NOT in that
# snippet -- copy it from the Realtime Database page.
#
# These are public values that ship in the client bundle; they are not secrets.
#
# projectId is where the build reads your project name. The Firebase CLI cannot
# read this file, so scripts/syncFirebaseRc.js copies this value into
# .firebaserc; it runs automatically on launch, onboarding, and deploys. Keep
# the two equal -- a deploy aborts if they disagree.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_DATABASE_URL=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# The robot's own Firebase Authentication account, one per robot. Unlike the
# keys above, these ARE secrets: they are never bundled or put in a URL, only
# injected into the trusted robot browser context.
ROBOT_USERNAME=
ROBOT_PASSWORD=

# ---------------------------------------------------------------------------
# Build mode
# ---------------------------------------------------------------------------
# development (default) runs webpack watchers, so edits to interface code
# rebuild on save. production builds the bundles once at launch; use this on
# fielded robots.
WEB_TELEOP_BUILD_MODE=development

# ---------------------------------------------------------------------------
# Voice control (optional)
# ---------------------------------------------------------------------------
# Stretch Voice Control (SVC) is off by default. Turning it on takes two
# separate things: the feature flag, and your own OpenAI API key.
#
# 1. The flag. Feature flags are NOT read from this file -- feature-flags.js
#    reads the process environment directly, so a FEATURE_ line added here has
#    no effect. Either set voice_control_interface to true in features.json:
#
#      {"voice_control_interface": {"enabled": true, ...}}
#
#    or prefix a single run, which overrides features.json for that launch:
#
#      FEATURE_VOICE_CONTROL_INTERFACE=1 ./launch_interface.sh
#
#    features.json also carries voice_input_recording, which additionally saves
#    audio clips of what was said. The voice JSONL interaction logs are written
#    whenever voice_control_interface is on, with or without it.
#
# 2. The API key below. Create one at https://platform.openai.com/api-keys. It
#    needs access to the Realtime API, and usage is billed to your OpenAI
#    account. Leave it empty if voice control is off; with the flag on but no
#    key, the server starts and warns, and every voice session fails to mint.
#
# Unlike the Firebase keys above, this is a real secret. It never leaves the
# robot: the local server uses it to mint short-lived Realtime credentials, and
# the browser only ever receives those. It is not in the webpack allowlist, so
# it cannot reach a bundle.
OPENAI_API_KEY=
