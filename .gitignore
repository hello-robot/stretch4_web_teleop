# Dependencies
/node_modules
/.pnp
.pnp.js

# testing
# Testing
/coverage

# production
# Production
/build

# misc
.DS_Store
# Secrets
# .env.example is the tracked template; the real .env never is.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dep locks
package-lock.json

# individual certificates
# Individual certificates
certificates/*
mkcert*

# Build output
dist/*
dist-firebase/*

# Outcomes
outcomes/*

# Compiled Python
*/__pycache__

# Specialized URDFs
urdf/*.urdf

# Firebase
# Project identity is per-machine. Create it with `firebase use --add`, or let
# scripts/syncFirebaseRc.js write it from projectId in .env.
.firebaserc
.firebase/
firebase-debug.log*
database-debug.log*
firestore-debug.log*
ui-debug.log*
.runtimeconfig.json

# Cursor
.cursor/*
